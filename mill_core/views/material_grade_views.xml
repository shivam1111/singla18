<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Material Grade Tree View -->
    <record id="view_material_grade_list" model="ir.ui.view">
        <field name="name">material.grade.list</field>
        <field name="model">material.grade</field>
        <field name="arch" type="xml">
            <list string="Material Grades" editable="bottom">
                <field name="name"/>
                <field name="standard"/>
                <field name = "description" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="action_material_grade" model="ir.actions.act_window">
        <field name="name">Material Grade</field>
        <field name="res_model">material.grade</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_material_grade"
              name="Material Grade"
              parent="mill_core.menu_mill_configuration"
              action="action_material_grade"/>
</odoo>
