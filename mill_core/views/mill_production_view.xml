<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!--    mill.production-->
       <record id="view_mill_production_trees" model="ir.ui.view">
       		<field name="name">mill.production.tree</field>
       		<field name="model">mill.production</field>
       		<field name="arch" type="xml">
       			<list decoration-danger="state == 'draft'" decoration-info="state == 'done'"  string = "Production Register">
       				<field name = "name" />
       				<field name = "date" />
       				<field name = "hours"  sum = "Total Hours"/>
					<field name = "total_production" sum = "Total Production" />
					<field name = "units_per_mt" avg = "Units/MT" />
					<field name = "production_mt" avg="Production Rate" />
					<field name = "coal_pmt" avg="Average Coal Consumption" />
					<field name = "solar_net" sum="Total Solar Production" />
       			</list>
       		</field>
   		</record>

       <record id="view_mill_production_form" model="ir.ui.view">
       		<field name="name">mill.production.form</field>
       		<field name="model">mill.production</field>
       		<field name="arch" type="xml">
       			<form string  = "Production Register" >
					<header>
						<button invisible="state == 'done' "  confirm="Are you sure you want to execute the production ?"
								name="action_confirm" type="object" string="Confirm" class="oe_highlight" />
<!--	Will add this when states functionality starts						states="draft"-->
						<button invisible="state == 'draft' "  name="action_draft" type="object" string="Set to Draft" class="oe_highlight" />
						<field name = "state" widget="statusbar" clickable="1" statusbar_visible="draft,done" />
					</header>
					<sheet>
						<div class="oe_title">
							<h1>
								<field name="name" readonly="1"/>
							</h1>
						</div>
	                    <group>
	                    		<group>
	                    			<field name = "date" />
	                    			<field name = "hours" />
									<field name = "coal" />
	                    			<field name = "mill_kara"/>
	                    			<field name = "furnace_kara"/>
	                    			<field name = "miss_roll" />
									<field name = "md_mt"/>
									<field name = "size_ids" widget="many2many_tags"/>
									<field name = "order_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}" />
	                    		</group>
	                    		<group>
									<field name ="total_production"/>
									<field name = "png_net" />
									<field name = "total_units"/>
									<field name = "total_scrap"/>
									<field name = "scrap_percentage"/>
									<field name = "units_per_mt"/>
									<field name = "png_net_mt"/>
									<field name = "coal_pmt" />
									<field name = "production_mt"  />
									<field name = "solar_net" />

	                    		</group>
	                    </group>
	                    <notebook>
	                    		<page string = "Production">
	                    			<field name = "production_line_ids" context = "{'default_type':'production'}"
									readonly="state=='done'">
	                    				<list string = "Production" editable = "top" default_order="sequence" >
	                    					<field name = "sequence" widget = "handle" />
	                    					<field name = "name"  readonly = "1"/>
	                    					<field name = "size_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}" />
	                    					<field name = "batch" />
	                    					<field name = "pcs" sum = "Total Pcs" />
	                    					<field name = "kg_per_pc" />
	                    					<field name = "qty" sum ="Total Production"/>
	                    					<field name = "partner_id" />
	                    					<field name = "heat_ids" widget="many2many_tags" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}" />
	                    					<field name = "product_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}"/>
	                    					<field name = "production_line_id" string = "Bundle No."   options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
											<field name = "scrap" sum = "Total Scrap" />
											<field name = "scrap_percentage" />
	                    					<field name = "remarks" />
											<button name="action_view_production_order_line" title="Open Manufacturing Order" icon="fa-wrench"
													invisible="not picking_id"
													type="object"  string="View"  class="text-primary"/>
	                    				</list>
	                    			</field>
	                    		</page>
								<page string = "Unit Consumption" >
									<group>
										<group>
											<field name = "kwh_opening"/>
											<field name = "kwh_closing"/>
										</group>
										<group>
											<field name = "kva_opening"/>
											<field name = "kva_closing"/>
										</group>
									</group>
								</page>
								<page string = "PNG">
									<group >
										<field name = "png_units_opening" />
										<field name = "png_units_closing" />
									</group>
								</page>
								<page string = "Water Consumption">
									<group >
										<field name = "water_units_opening" />
										<field name = "water_units_closing" />
									</group>
								</page>
								<page string = "Solar Generation">
									<group string = "UNIT 1">
										<group>
											<field name = "solar_units_opening_kwh" />
											<field name = "solar_units_closing_kwh" />
										</group>
										<group>
											<field name = "solar_units_opening_kvah" />
											<field name = "solar_units_closing_kvah" />
										</group>
									</group>
									<group string = "UNIT 2">
										<group>
											<field name = "solar_units_opening_kwh_2" />
											<field name = "solar_units_closing_kwh_2" />
										</group>
										<group>
											<field name = "solar_units_opening_kvah_2" />
											<field name = "solar_units_closing_kvah_2" />
										</group>
									</group>
								</page>
								<page string = "Stock Movement">
									<field name="all_picking_ids" readonly="1">
										<list string="Transfers">
											<field name="name" string="Reference"/>
											<field name="location_id"/>
											<field name="location_dest_id"/>
											<field name="origin"/>
											<field name="state" widget="badge"
												   decoration-success="state == 'done'"
												   decoration-info="state not in ('done', 'cancel')"/>
										</list>
									</field>
								</page>
	                    </notebook>
	                    <group>
	                    		<field name = "remarks" nolabel = "1" placeholder = "Remarks"/>
	                    </group>
					</sheet>
				</form>
			</field>
	   </record>

	<record id="view_mill_production_filter" model="ir.ui.view">
		<field name="name">mill.production.search</field>
		<field name="model">mill.production</field>
		<field name="arch" type="xml">
			<search string="Search Orders">
				<field name = "name" />
				<field name="size_ids" string="Size"/>
				<field name = "production_line_ids" string = "Production Line" />
				<field name="production_line_ids" string="Heat No." filter_domain="[('production_line_ids.heat_ids','ilike',self)]"/>
				<field name="production_line_ids" string="Bundle No." filter_domain="[('production_line_ids.production_line_id','ilike',self)]"/>
		   </search>
		</field>
	</record>

    <record id="action_mill_production_views" model="ir.actions.act_window">
        <field name="name">Mill Production</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mill.production</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by':'date:month'}</field>
    </record>
    <menuitem id ="menu_mill_production_submenu" name = "Mill Production"
              action = "action_mill_production_views"
              parent = "menu_mill_production" />

	<!-- Views for mill.production.line -->
   <record id="view_mill_production_line_tree" model="ir.ui.view">
		<field name="name">mill.production.line.tree</field>
		<field name="model">mill.production.line</field>
		<field name="arch" type="xml">
			<list string = "Production">
				<field name = "name" />
				<field name = "size_id"/>
				<field name = "product_id"/>
				<field name = "production_id" />
				<field name = "remarks"/>
			</list>
		</field>
   </record>

   <record id="view_mill_production_line_form" model="ir.ui.view">
		<field name="name">mill.production.line.form</field>
		<field name="model">mill.production.line</field>
		<field name="arch" type="xml">
			<form string  = "Production" >
				<header>
					<button invisible="state == 'draft' or return_picking_id"
							groups="base.group_system"
							name="action_return_picking" type="object"
							string="Return" class="oe_highlight" />

					<field name = "state" widget="statusbar" clickable="1" statusbar_visible="draft,done" />
				</header>
				<sheet>
					<div class="oe_title">
						<h1>
							<field name="name" readonly="1"/>
						</h1>
					</div>
					<group>
						<group>
							<field name = "size_id" />
							<field name = "product_id"/>
							<field name = "qty" />
							<field name = "partner_id" />
							<field name = "remarks"/>
						</group>
						<group>
							<field name = "pcs"/>
							<field name = "kg_per_pc"/>
							<field name = "batch"/>
							<field name = "production_id" readonly="1" clickable ="1"/>
							<field name = "picking_id" readonly="1"/>
							<field name = "return_picking_id" readonly="1"/>
						</group>
					</group>
					<notebook>
						<page string = "Heats">
							<field name = "heat_ids" nolabel="1"/>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
   </record>

</odoo>