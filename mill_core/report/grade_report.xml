<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    		<template id="report_material_grade_document">
    			<t t-call="web.external_layout">
    				<div class = "page">
					<div class="oe_structure"/>
						<div style = "text-align:center;"><h2><t t-esc="doc.print_name"/></h2></div>
						<table class = "table table-sm o_main_table table-borderless mt-4 caption-top">
			            		<caption>CHEMICAL COMPOSITION</caption>
			            		 <thead style="display: table-row-group">
									<tr>
										<th class="text-start">ELEMENTS</th>
										<t t-foreach="doc.chemistry_ids" t-as="l">
											<th class="text-start">
												%<t t-esc="l.element_id.code"/>
											</th>
										</t>
									</tr>
			            		</thead>
			            		<tbody>
			            			<tr>
			            				<td>MIN</td>
				            			<t t-foreach="doc.chemistry_ids" t-as="l">
				            				<td style = "text-transform:uppercase;">
				            					<t t-esc="l.min_value or '-'"/>
				            				</td>
				            			</t>
			            			</tr>
			            			<tr>
			            				<td>MAX</td>
				            			<t t-foreach="doc.chemistry_ids" t-as="l">
				            				<td style = "text-transform:uppercase;">
				            					<t t-esc="l.max_value or '-'"/>
				            				</td>
				            			</t>
			            			</tr>
			            		</tbody>
			            </table>
<!--					<div class = "row">-->
<!--	            			<p t-field="doc.description" />-->
<!--		            </div>-->
    				</div>
    			</t>
    		</template>
		<template id="report_material_grade">
		    <t t-call="web.html_container">
		        <t t-foreach="docs" t-as="doc">
		            <t t-call="mill_core.report_material_grade_document"/>
		        </t>
		    </t>
		</template>
    </data>
</odoo>