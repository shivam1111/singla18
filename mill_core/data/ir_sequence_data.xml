<?xml version="1.0" encoding="utf-8"?>
<odoo>
   	<data noupdate="1">

        <!-- Sequence for production.order.line -->
        <record id="seq_production_order_line" model="ir.sequence">
            <field name="name">Production Order Line</field>
            <field name="code">production.order.line</field>
            <field name="prefix">B</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for production.order -->
        <record id="seq_production_order" model="ir.sequence">
            <field name="name">Production Order</field>
            <field name="code">production.order</field>
            <field name="prefix">POR</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>


        <!-- Sequence for mill.production.line -->
        <record id="seq_mill_production_line" model="ir.sequence">
            <field name="name">Mill Production Line</field>
            <field name="code">mill.production.line</field>
            <field name="prefix">POL</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for mill.production -->
        <record id="seq_mill_production" model="ir.sequence">
            <field name="name">Mill Production</field>
            <field name="code">mill.production</field>
            <field name="prefix">MO</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequences for heat.heat -->
        <record id="seq_heat_heat" model="ir.sequence">
            <field name="name">Heat</field>
            <field name="code">heat.heat</field>
            <field name="prefix">H</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>   	
    </data>
</odoo>
