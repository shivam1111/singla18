<?xml version="1.0" encoding="utf-8"?>
<odoo>
       <!-- Chemical Composition -->
    <record id="view_chemical_compostion_tree" model="ir.ui.view">
        <field name="name">chemical.composition.tree</field>
        <field name="model">chemical.composition</field>
        <field name="arch" type="xml">
            <list string = "Test Certificates" >
                    <field name = "name" />
                    <field name= "partner_id"/>
                    <field name = "date" />
                    <field name = "grade_id"/>
                    <field name = "heat_no"/>
                    <field name = "invoice_no" />
                    <field name = "size" />
                </list>
        </field>
    </record>

    <record id="view_chemical_compostion_form" model="ir.ui.view">
        <field name="name">chemical.composition.form</field>
        <field name="model">chemical.composition</field>
        <field name="arch" type="xml">
            <form string = "Test Certificates">
                <header>
                        <button name="action_print_heat_report_docx"
                        string="Print Heat Report"
                        type="object"
                        class="btn-primary"
                        icon="fa-file-word-o"/>
                </header>
                <sheet>
                    <field name = "company_id" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                            <group>
                                <field name = "partner_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}" />
                                <field name = "invoice_no" />
                                <field name = "no_of_pieces" />
                                <field name = "size" />
                                <field name = "qty" />
                                <field name = "route_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}" />
                            </group>
                            <group>
                                <label for="grade_id" string="Grade"/>
                                <div class="o_row">
                                    <field name="grade_id" options="{'no_create': True}"/>
                                    <button name="update_composition_lines"
                                            type="object"
                                            icon="fa-refresh"
                                            title="Update Composition Lines"
                                            class="btn-link text-primary p-0"/>
                                </div>
                                <field name = "date" />
                                <field name = "truck_no" />
                                <field name = "heat_no" />
                                <field name = "color_code" />
                            </group>
                    </group>
                    <group string = "Metalurgical Properties">
                            <group>
                                <field name = "min_hardness" />
                                <field name = "complete_decarb" />
                                <field name = "reduction_ratio" />
                                <field name = "spark_test" />
                                <field name = "is_mpi" />
                                <field name = "lateral_bend" />
                            </group>
                            <group>
                                <field name = "max_hardness" />
                                <field name = "partial_decarb" />
                                <field name = "grain_size" />
                                <field name = "surface_inspection" />
                                <field name = "is_ut" />
                                <field name = "length" />
                            </group>
                    </group>
                    <notebook>
                        <page string = "Chemical Composition">
                            <group>
                                <field name = "heat_id" context="{'onchange_heat_id':True}" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}" />
                            </group>
                            <field name = "line_ids" nolabel = "1">
                                <list string = "Composition Line" editable = "bottom">
                                    <field name = "sequence" widget="handle"/>
                                    <field name = "element_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}" />
                                    <field name = "min_val" />
                                    <field name = "max_val"/>
                                    <field name = "actual_val" />
                                </list>
                            </field>
                            <group>
                                <field name = "carbon_equivalence" />
                                <field name = "nicrmo" />
                            </group>

                        </page>
                        <page string = "Inclusion Rating">
                            <field name = "inclusion_rating_ids" nolabel = "1">
                                <list string = "Inclusion Rating" editable = "bottom">
                                    <field name = "type" />
                                    <field name = "thin" />
                                    <field name = "thick" />
                                </list>
                            </field>
                        </page>
                        <page string = "Mechanical Properties">
                            <group>
                                <group>
                                    <field name = "ultimate_tensile_strength" />
                                    <field name = "elongation" />
                                </group>
                                <group>
                                    <field name = "yield_strength" />
                                </group>
                            </group>
                        </page>
                        <page string = "Gas Analysis">
                            <group>
                                <field name = "gas_o2"/>
                                <field name = "gas_h2" />
                                <field name = "gas_n2" />
                            </group>
                        </page>
                        <page string = "Remarks" >
                            <field name = "remarks" placeholder="Remarks" nolabel = "1"/>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chemical_composition_filter" model="ir.ui.view">
        <field name="name">chemical.composition.list.select</field>
        <field name="model">chemical.composition</field>
        <field name="arch" type="xml">
            <search string="Search Compositions">
                <field name="name" string="Serial Number" filter_domain="[('name','ilike',self)]"/>
                <field name="partner_id" operator="child_of"/>
                <field name="grade_id"/>
                <field name="heat_no"/>
                <field name = "invoice_no" />
                <group expand="0" string="Group By">
                    <filter string="Partner" name = "group_partner_id" domain="[]" context="{'group_by':'partner_id'}"/>
                    <filter string="Grade" name = "group_partner_id" domain="[]" context="{'group_by':'grade_id'}"/>
                </group>
           </search>
        </field>
    </record>

    <record id="action_chemical_composition" model="ir.actions.act_window">
        <field name="name">Test Certificates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">chemical.composition</field>
        <field name="view_mode">list,form</field>
        <field name = "search_view_id" ref = "view_chemical_composition_filter" />
    </record>

<!--    <menuitem id = "menu_certificates_management"-->
<!--              name = "Test Certificates"-->
<!--              parent = "mill_order.mill_menu_root"-->
<!--              sequence = "100" />-->

    <menuitem
           id= "submenu_test_certificates"
           parent= "mill_core.menu_mill_root"
           sequence= "100"
           action = "action_chemical_composition"
            />
</odoo>