<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mill_technical_detail_tree" model="ir.ui.view">
        <field name="name">technical.detail</field>
        <field name="model">technical.detail</field>
        <field name="arch" type="xml">
            <list string="Technical Details" editable="bottom" >
                <field name = "partner_id" />
                <field name = "size_id" />
                <field name = "length_primary" />
                <field name = "secondary_length" />
            </list>
        </field>
    </record>

    <!-- Mill Heat Search -->
    <record id="view_mill_technical_detail_search" model="ir.ui.view">
        <field name="name">mill.technical.detail.search</field>
        <field name="model">technical.detail</field>
        <field name="arch" type="xml">
            <search>
                <field name = "partner_id"/>
                <field name = "size_id"/>
                <group expand="0" string="Group By">
                    <filter string="Customer"
                            name = "group_partner_id"
                            context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mill_technical_detail" model="ir.actions.act_window">
        <field name="name">Technical Details</field>
        <field name="res_model">technical.detail</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_material_element"
              name="Technical Details"
              parent="mill_core.menu_mill_configuration"
              action="action_mill_technical_detail"
              sequence="30"/>
</odoo>