<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_rolling_mill" model="ir.ui.view">
        <field name="name">purchase.order.form.rollng.mill</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add fields inside the PO Lines notebook grid -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="before">
                <field name="heats" sum="Total Heats"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="basic_rate"/>
                <field name="extra_rate"/>
                <field name="net_rate" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_rolling_mill" model="ir.ui.view">
        <field name="name">purchase.order.tree.rolling.mill</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <!-- Adds visible columns to the main list overview dashboard -->
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="order_line" widget="many2many_tags" string="Products/Grades" optional="show"/>
                <!-- Pulling calculations through to line aggregate indicators if single-grade PO pattern is kept -->
                <field name="invoice_status" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_rolling_mill" model="ir.ui.view">
        <field name="name">stock.picking.tree.rolling.mill</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <!-- Injects columns directly before the system status column -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="currency_id" invisible="1"/>
                <field name="po_net_rate" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>


</odoo>